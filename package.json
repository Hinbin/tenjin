    "@types/webpack": "5",
    "alpinejs": "^3.15.12",
    "babel-loader": "9",
    "bootstrap": "^5",
    "compression-webpack-plugin": "11",
    "core-js": "3",
    "css-loader": "^7.1.2",
    "flatpickr": "^4.6.13",
    "mini-css-extract-plugin": "^2.9.0",
    "sass": "^1.77.6",
    "sass-loader": "^14.2.1",
    "shakapacker": "8.4.0",
