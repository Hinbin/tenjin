- content_for :title
  title=('Leaderboard - ' + @subject.name)

- alpine_data = { subjectName: @subject.name, schoolName: @school.name, schoolGroupName: @school_group&.name, topicId: @topic&.id, canSeeLiveToggle: %w[employee school_admin].include?(current_user.role) }

.container
  .row.py-3
    .col-4.d-none.d-lg-block
      = render 'subject_select'
    .col
      div x-data=("liveLeaderboard(" + alpine_data.to_json + ")")
        template x-if="loading"
          .loader Loading...
        template x-if="!loading"
          div
            .row
              .col.d-none.d-md-block
                h1 x-text="name"
              .col
                template x-if="winnerClassroom()"
                  p
                    b.fw-bold x-text="winnerClassroom() + ' winner: '"
                    span x-text="winnerLabel()"

            template x-if="canSeeLiveToggle"
              .row
                .col
                  .form-check.form-switch#toggleLive
                    input#liveSwitch.form-check-input type="checkbox" x-model="live" @change="toggleLive()"
                    label.form-check-label for="liveSwitch" Live Leaderboard

            .row.g-2.align-items-center.d-flex.justify-content-around
              .col.col-6 x-data="{ open: false }" @click.outside="open = false"
                .mb-3
                  .dropdown.filter#Class-dropdown
                    button.btn.btn-secondary.dropdown-toggle type="button" @click="open = !open" x-text="selectedFilterText('Class', 'Select Class')"
                    .dropdown-menu :class="open && 'show'"
                      template x-for="opt in classroomFilterOptions()" :key="opt"
                        button.dropdown-item type="button" :id="'Class-' + opt.replace(/ /g, '-')" @click="setFilter('Class', opt); open = false" x-text="opt"

              template x-if="schoolFilterOptions().length"
                .col.col-6 x-data="{ open: false }" @click.outside="open = false"
                  .mb-3
                    .dropdown.filter#Schools-dropdown
                      button.btn.btn-secondary.dropdown-toggle type="button" @click="open = !open" x-text="selectedFilterText('Schools', 'Select School')"
                      .dropdown-menu :class="open && 'show'"
                        template x-for="opt in schoolFilterOptions()" :key="opt"
                          button.dropdown-item type="button" :id="'Schools-' + opt.replace(/ /g, '-')" @click="setFilter('Schools', opt); open = false" x-text="opt"

              template x-if="!live"
                .col
                  .form-check.form-switch#showAll
                    input#showAllSwitch.form-check-input type="checkbox" x-model="showAll"
                    label.form-check-label for="showAllSwitch" Show all

              template x-if="!live"
                .col.col-sm
                  .form-check.form-switch#allTime
                    input#allTimeSwitch.form-check-input type="checkbox" x-model="allTime" @change="onAllTimeToggle()"
                    label.form-check-label for="allTimeSwitch" All Time

            .row
              table.table#leaderboardTable
                thead
                  tr
                    th #
                    th
                    th Name
                    th
                    th.d-none.d-lg-table-cell x-text="contextualHeader()"
                    th Score
                tbody x-html="sortedEntriesHtml()"

        span#connected x-show="connected" style="display: none"
