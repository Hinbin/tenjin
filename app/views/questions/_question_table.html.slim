- table_options = { paginationSize: 50, placeholder: 'No questions have been found' }.to_json
.table-wrapper data-controller='datatable' data-datatable-options-value=table_options
  = render 'shared/table_search'
  table.table#questionTable data-datatable-target='table'
    thead
      tr
        th #
        th Question
        th Times Asked
        th Flags
        th % Correct
        th Lesson
    tbody
      - @questions.order(:created_at).each_with_index do |q, index|
        tr id="question-#{q.id}"
          td = index + 1
          td.question-text = link_to q.question_text.blank? ? 'Click here to edit' : q.question_text, q
          td.amount = times_asked(q)
          td.flags = q.flagged_questions.size
          td.correct = percentage_correct(q)
          td.lesson = q.lesson.present? ? q.lesson.title : '-'
