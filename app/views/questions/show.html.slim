- content_for :title
  title = 'Edit Question'
.tjs-dashboard.tjs-dashboard--teacher
  = render 'shared/skin/backdrop'
  .tjs-dashboard__inner
    header.tj-tsurface-header
      h1.tjs-display.tj-tsurface-title Edit Question

    section.tjs-dashboard__section
      .tjs-card#questionEditor
        = render('question_edit_form')
      .tj-row-actions
        - if @question.pending?
          = link_to 'Back to Review Queue', question_reviews_path, class: 'tjs-btn tjs-btn--ghost'
        - else
          = link_to 'Back to Topic Questions', topic_path(@question.topic), class: 'tjs-btn tjs-btn--ghost'

    section.tjs-dashboard__section
      = render 'shared/skin/section_head', en: 'Statistics', jp: '統計'
      .tjs-card
        .tj-stats-grid
          p
            ' Times Asked:
            = times_asked(@question)
          p
            ' Percent Correct:
            = percentage_correct(@question)
          p
            ' Flags:
            = @question.flagged_questions.size
      .tj-row-actions
        = link_to 'Reset Question Flags',
          reset_flags_question_path,
          data: { turbo_method: 'patch' },
          class: 'tjs-btn tjs-btn--secondary'
        = link_to (@question.pending? ? 'Delete from queue' : 'Delete Question'),
          question_path(@question),
          data: { turbo_confirm: 'Are you sure?', turbo_method: 'delete' },
          class: 'tjs-btn tjs-btn--danger'

dialog#noCorrectAnswerModal
  .tj-dialog-content
    .tj-dialog-body Please select at least one correct answer
    .tj-dialog-footer
      button.tjs-btn.tjs-btn--ghost type='button' onclick='this.closest("dialog").close()' Close
