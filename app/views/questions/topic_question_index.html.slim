.container
  .row.mt-3.mb-3
    .col-sm-3
      label for='topic-name' class='form-label' Topic Name:
    .col-sm-9
      = form_with url: topic_path(@topic), method: :patch, data: { turbo: true, controller: 'auto-submit' } do
        = text_field_tag 'topic[name]',
          @topic.name,
          id: 'topic-name',
          class: 'form-control',
          data: { action: 'change->auto-submit#submit' }
  .row.mb-3
    .col-sm-3
      label for="select-default-lesson" class='form-label' Select Default Lesson
    .col-sm-9
      = form_with url: topic_path(@topic), method: :patch, data: { turbo: true, controller: 'auto-submit' } do
        = select_tag 'topic[default_lesson_id]',
          options_from_collection_for_select(Lesson.where(topic: @topic), :id, :title, selected: @topic.default_lesson_id),
          include_blank: 'No default lesson',
          id: 'select-default-lesson',
          class: 'form-select',
          data: { action: 'change->auto-submit#submit' }
  .row.my-2
    .col
      =link_to 'Add Question', new_question_path(question: { topic_id: @topic }), class:'btn btn-primary w-100'
  .row.my-2
    .col
      = render 'question_table'
  .row.my-2
    .col
      = link_to 'Download Questions',
          download_topic_questions_path(topic_id: @topic),
          class:'btn btn-primary w-100'
      = link_to 'Import Questions',
          import_topic_questions_path(topic_id: @topic),
          class:'btn btn-primary w-100'

  .row.my-5
    .col
      = button_to 'Delete Topic',
        topic_path(@topic),
        method: :delete,
        class: 'btn btn-danger w-100',
        form: { data: { turbo: true, turbo_confirm: 'Are you sure?  This cannot be undone' } }
