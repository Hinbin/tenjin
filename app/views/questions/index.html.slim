.container
  -@subjects.each do |s|
    .display-3.my-3 =s.name
    =link_to 'Add Topic', new_topic_path(subject: {subject_id: s.id}), class: 'btn btn-primary w-100'
    =link_to 'Most Flagged Questions', flagged_questions_questions_path( subject_id: s.id), class: 'btn btn-info w-100'
    table.table
      thead
        tr
          th Topic Name
          th Question #
      - s.topics.select(&:active?).sort_by(&:name).each do |t|
        tr
          td =link_to t.name, topic_questions_path(topic_id: t)
          td =t.questions.size
