=form_with model: @question, id:'questionForm' do |f|
  .tjk-field.tjk-field--horizontal
    .tjk-label.tjk-label--horizontal
      =f.label('select-question-type', 'Question Type')
    .tjk-field__control
      =f.select( :question_type,
        options_for_select(Question.question_types.to_a.map { |k| [k[0].humanize, k[0]] }, selected: @question.question_type ),
        {},
        id: 'select-question-type',
        class: 'tjk-input reload-page' )
  .tjk-field
    =f.rich_text_area :question_text
    - @question.errors[:question_text].each do |e|
      p.error = e
    - @question.errors[:base].each do |e|
      p.error = e
  .tjk-field
    =f.label :explanation, 'Explanation (optional)'
    =f.text_area :explanation, class: 'tjk-input', rows: 2,
      placeholder: 'Shown to students after they answer — explain why the correct answer is right.'
    p.tjk-hint Helps students learn from mistakes. Displayed beneath the correct answer on the reveal.
  .tjk-field.tjk-field--horizontal
    .tjk-label.tjk-label--horizontal
      =f.label('select-lesson', 'Lesson:')
    .tjk-field__control
      =f.select( :lesson_id,
          options_from_collection_for_select(@question.topic.lessons, :id, :title, selected: @question.lesson_id),
          { include_blank: 'Select Lesson' },
          id: 'select-lesson',
          class: 'tjk-input')
  .tjk-field.tjk-field--horizontal
    .tjk-label.tjk-label--horizontal
      =f.label('select-topic', 'Topic:')
    .tjk-field__control
      =f.select( :topic_id,
          options_from_collection_for_select( @question.topic.subject.topics.order(:name),
            :id, :name, selected: @question.topic_id),
          {},
          id: 'select-topic',
          class: 'tjk-input reload-page')
  - if @question.structured?
    = render 'structured_builder', f: f
  - else
    table.tj-table#table-answers
      thead
        tr
          th Answer Text
          th = "Correct?" unless @question.short_answer?
          th
      tbody.fields
        =f.fields_for :answers, @question.answers do |a|
          =render 'answer', f: a
    =link_to_add_row('Add Answer', f, :answers, class: 'tjs-btn tjs-btn--secondary tj-btn--full')
  =f.submit(@question.pending? ? 'Accept and save' : 'Save Question', class: 'tjs-btn tjs-btn--primary tj-btn--full')
