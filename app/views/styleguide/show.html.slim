/ Dev-only skin styleguide (Plan 01, Phase 0).
/ Proves the theme engine: every primitive below is skin-aware, switched live via the body's
/ `theme` Stimulus controller. Feeds the controller the full resolved catalog (this page only).
- content_for :theme_catalog, theme_catalog_json
- content_for :title
  title Skin Styleguide

.tjs-styleguide style="max-width:1100px;margin:0 auto;padding:2rem 1.25rem;position:relative;"
  = render 'shared/skin/backdrop'

  h1.tjs-display style="font-size:2rem;margin-bottom:0.25rem;position:relative;z-index:1;" Skin Styleguide
  p style="color:var(--dim);margin-top:0;position:relative;z-index:1;" Phase 0 proving ground — switch skin · palette · mode and watch every primitive reskin.

  / ── Switcher ──────────────────────────────────────────────
  .tjs-card style="padding:1rem;margin:1.25rem 0;display:flex;flex-wrap:wrap;gap:1.5rem;align-items:flex-start;position:relative;z-index:1;"
    div
      .tjs-display style="font-size:0.8rem;margin-bottom:0.4rem;" Skin
      .tjs-flex style="display:flex;gap:0.4rem;flex-wrap:wrap;"
        - @skins.each do |id, meta|
          button.tjs-btn.tjs-btn--ghost type="button" data-action="theme#select" data-theme-skin-param=id style="padding:6px 12px;"
            = meta[:label]
            - if meta[:jp]
              span style="font-family:var(--f-pixel);font-size:9px;margin-left:4px;opacity:0.6;" = meta[:jp]
    div
      .tjs-display style="font-size:0.8rem;margin-bottom:0.4rem;" Palette
      .tjs-flex style="display:flex;gap:0.4rem;flex-wrap:wrap;"
        - 4.times do |idx|
          button.tjs-btn.tjs-btn--ghost type="button" data-action="theme#select" data-theme-palette-param=idx style="padding:6px 12px;"
            = "P#{idx}"
    div
      .tjs-display style="font-size:0.8rem;margin-bottom:0.4rem;" Mode
      .tjs-flex style="display:flex;gap:0.4rem;"
        button.tjs-btn.tjs-btn--ghost type="button" data-action="theme#select" data-theme-mode-param="dark" style="padding:6px 12px;" Dark
        button.tjs-btn.tjs-btn--ghost type="button" data-action="theme#select" data-theme-mode-param="light" style="padding:6px 12px;" Light
    div
      .tjs-display style="font-size:0.8rem;margin-bottom:0.4rem;" &nbsp;
      button.tjs-btn.tjs-btn--ghost type="button" data-action="theme#reset" style="padding:6px 12px;" Reset

  / ── Logo ──────────────────────────────────────────────────
  = render 'shared/skin/section_head', en: 'Logo', jp: 'ロゴ'
  .tjs-card style="padding:1.1rem;display:inline-flex;"
    = render 'shared/skin/logo'

  / ── Buttons ───────────────────────────────────────────────
  = render 'shared/skin/section_head', en: 'Buttons', jp: 'ボタン'
  .tjs-flex style="display:flex;gap:0.75rem;flex-wrap:wrap;align-items:center;"
    button.tjs-btn.tjs-btn--primary type="button" Primary
    button.tjs-btn.tjs-btn--ghost type="button" Ghost

  / ── Cards ─────────────────────────────────────────────────
  = render 'shared/skin/section_head', en: 'Cards', jp: 'カード'
  .tjs-grid style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem;"
    .tjs-card style="padding:1.1rem;"
      .tjs-display style="font-size:1rem;" Plain card
      p style="color:var(--dim);margin:0.4rem 0 0.8rem;" Surface, ink and border from tokens.
      .tjs-bar
        .tjs-bar__fill style="width:64%;"
    .tjs-card.tjs-tile style="padding:1.1rem;cursor:pointer;"
      .tjs-display style="font-size:1rem;" Interactive tile
      p style="color:var(--dim);margin:0.4rem 0 0;" Hover/press transition (.tjs-tile).

  / ── Subject tiles (no photo) ──────────────────────────────
  = render 'shared/skin/section_head', en: 'Subject tiles', jp: '科目'
  .tjs-grid style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem;"
    - [["chip","Computer Science","CS","--n1"],["scroll","History","HI","--n2"],["globe","Geography","GE","--n3"],["tag","Business","BU","--gold"]].each do |g, name, short, tok|
      .tjs-card.tjs-tile style="padding:1.1rem;display:flex;flex-direction:column;gap:0.6rem;cursor:pointer;"
        .tjs-flex style="display:flex;justify-content:space-between;align-items:center;"
          span style="color:var(#{tok});"
            = glyph(g, size: 26, color: "var(#{tok})", css_class: "tjs-icon--glow")
          span.tjs-display style="font-size:1.6rem;color:var(--line);" = short
        .tjs-display style="font-size:0.95rem;" = name
        .tjs-bar style="height:6px;"
          .tjs-bar__fill style="width:62%;background:var(#{tok});"

  / ── Avatar ────────────────────────────────────────────────
  = render 'shared/skin/section_head', en: 'Avatars', jp: '化身'
  .tjs-flex style="display:flex;flex-wrap:wrap;gap:1rem;align-items:center;"
    - [:torii, :sakura, :flame, :bolt, :gem, :sparkle, :crown].each_with_index do |g, i|
      - tok = ["var(--n1)","var(--n2)","var(--n3)","var(--gold)","var(--n1)","var(--n2)","var(--gold)"][i]
      = render 'shared/skin/avatar', glyph_name: g, color: tok, size: 46

  / ── Stat chips ────────────────────────────────────────────
  = render 'shared/skin/section_head', en: 'Stat chips', jp: '統計'
  .tjs-flex style="display:flex;flex-wrap:wrap;gap:0.75rem;"
    = render 'shared/skin/stat', icon: :flame, value: '7', label: 'Streak', color: 'var(--n1)'
    = render 'shared/skin/stat', icon: :bolt, value: '180', label: 'Today', color: 'var(--gold)'
    = render 'shared/skin/stat', icon: :trophy, value: '#3', label: 'Rank', color: 'var(--n2)'
    = render 'shared/skin/stat', icon: :star, value: '12', label: 'Level', color: 'var(--n3)'

  / ── Pills ─────────────────────────────────────────────────
  = render 'shared/skin/section_head', en: 'Pills', jp: 'バッジ'
  .tjs-flex style="display:flex;flex-wrap:wrap;gap:0.5rem;align-items:center;"
    = render 'shared/skin/pill', text: 'Streak ×7', color: 'var(--n1)', glyph_name: :flame
    = render 'shared/skin/pill', text: 'Daily', color: 'var(--gold)'
    = render 'shared/skin/pill', text: 'Weekly', color: 'var(--n2)'
    = render 'shared/skin/pill', text: '+200 pts', color: 'var(--n3)'

  / ── Section headers ───────────────────────────────────────
  = render 'shared/skin/section_head', en: 'Section headers', jp: 'セクション'
  .tjs-card style="padding:1rem;"
    = render 'shared/skin/section_head', en: 'Practice', jp: '練習', action: 'See all', action_href: '#'
    p style="color:var(--dim);margin:0;" Section head with EN + JP subtitle and trailing action.

  / ── Bars ─────────────────────────────────────────────────
  = render 'shared/skin/section_head', en: 'Progress bars', jp: 'バー'
  .tjs-flex style="display:flex;flex-direction:column;gap:0.6rem;"
    .tjs-bar
      .tjs-bar__fill style="width:78%;"
    .tjs-bar
      .tjs-bar__fill style="width:45%;background:var(--n2);"
    .tjs-bar
      .tjs-bar__fill style="width:92%;background:var(--gold);"

  / ── Glyph row ─────────────────────────────────────────────
  = render 'shared/skin/section_head', en: 'Glyphs', jp: 'アイコン'
  .tjs-flex style="display:flex;flex-wrap:wrap;gap:1rem;color:var(--n1);"
    - %i[chip scroll globe flame bolt star check x target trophy torii sakura crown gem dice sparkle heart book clock home list chevron back play tag].each do |g|
      span title=g style="display:flex;flex-direction:column;align-items:center;gap:3px;"
        = glyph(g, size: 24, color: "var(--ink)")
        span style="font-size:9px;color:var(--dim);font-family:var(--f-pixel);" = g
