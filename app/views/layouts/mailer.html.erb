<!DOCTYPE html>
<html lang="en">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Tenjin</title>
  </head>
  <body style="margin:0;padding:0;background-color:#f8f9fa;font-family:Arial,Helvetica,sans-serif;font-size:16px;color:#212529;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f8f9fa;">
      <tr>
        <td align="center" style="padding:24px 16px;">
          <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;width:100%;background-color:#ffffff;">
            <tr>
              <td style="background-color:#000000;padding:20px;text-align:center;">
                <img src="<%= image_url('tenjinHeader.jpg') %>" alt="Tenjin" width="220" style="max-width:220px;height:auto;display:block;margin:0 auto;">
              </td>
            </tr>
            <tr>
              <td style="background-color:#ef4035;height:4px;line-height:4px;font-size:4px;">&nbsp;</td>
            </tr>
            <tr>
              <td style="padding:32px 40px;">
                <%= yield %>
              </td>
            </tr>
            <tr>
              <td style="background-color:#212529;padding:16px 40px;text-align:center;">
                <p style="margin:0;color:#ffffff;font-size:13px;">Tenjin &mdash; <a href="https://tenjin.outwood.com" style="color:#ef4035;text-decoration:none;">tenjin.outwood.com</a></p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
