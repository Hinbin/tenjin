- content_for(:page_meta) do
  meta name="description" content="Quizzes: learn, compete, succeed!"
  meta property="og:type" content="website"
  meta property="og:title" content="Tenjin"
  meta property="og:description" content="Quizzes: learn, compete, succeed!"

header.tj-home-hero
  = render 'shared/skin/backdrop', home_backdrop_signature
  .tj-home-hero__inner
    = render 'shared/skin/logo', size: 34
    h1.tjs-display.tj-home-hero__title#mastheadText = home_slogan
    p.tj-home-hero__sub Complete quizzes, beat your friends.
footer.tj-fixed-bottom.tj-text-right style='padding: 1rem'
  = link_to 'About', page_path('about'), class: 'tj-home-hero__link'
= render('student_login_modal')
