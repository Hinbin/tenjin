/ Quiz top bar + HUD — skin-aware (Plan 01, Phase 2). Rendered inside the .tjs-quiz shell (show).
/ KEEP: #streak / #answeredCorrect / #multiplier (questions_shared.js live-updates them) and the
/ .tj-progress__bar progressbar (system spec reads aria-valuenow).
- accent = subject_neon(@quiz.subject)
.tjs-quiz__top
  a.tjs-quiz__close href=dashboard_path aria-label='Exit quiz'
    = glyph(:x, size: 18, color: 'var(--dim)')
  .tjs-quiz__progress
    .tjs-bar
      .tjs-bar__fill.tj-progress__bar role='progressbar' aria-valuenow=@percent_complete aria-valuemin='0' aria-valuemax='100' style="width:#{@percent_complete}%;background:#{accent};"
  span.tjs-quiz__count = "#{@quiz.num_questions_asked + 1}/#{@quiz.questions.length}"
.tjs-quiz__hud data-answer-effect=equipped_answer_effect(current_user)
  / streak-aura container — equipped streak-aura cosmetic (Phase 4)
  .tjs-streak-aura class=streak_aura_class(equipped_streak_aura(current_user)) data-quiz-target='streakAura'
    = render 'shared/skin/meter', icon: :flame, color: 'var(--n1)', label: 'streak', value: @quiz.streak, value_id: 'streak'
  = render 'shared/skin/meter', icon: :check, color: 'var(--n2)', label: 'correct', value: @quiz.answered_correct, value_id: 'answeredCorrect'
  = render 'shared/skin/meter', icon: :bolt, color: 'var(--gold)', label: 'mult', value: @multiplier.multiplier, value_id: 'multiplier'
  / running leaderboard points this quiz — questions_shared.js ticks #leaderboardPoints up after each answer
  = render 'shared/skin/meter', icon: :star, color: 'var(--n3)', label: 'points', value: @quiz.leaderboard_points, value_id: 'leaderboardPoints'
