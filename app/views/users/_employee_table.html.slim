h1.page-section-header.text-uppercase Employees
==render_small_separator
.col.table-responsive data-controller='datatable' data-datatable-options-value=({ paginationSize: 10 }.to_json)
  = render 'shared/table_search'
  .mb-2
    button.btn.btn-secondary.btn-sm.me-2 type='button' data-action='click->datatable#copy' Copy
    button.btn.btn-secondary.btn-sm type='button' data-action='click->datatable#downloadCsv' CSV
  table.table#employees-table data-datatable-target='table'
    thead
      tr
        th Name
        th Username
        th.d-none.d-lg-table-cell Classes
        th Reset Password?
    tbody
      - @employees.each do |e|
        tr.employee-row data-id=e.id
          td
            => e.forename
            = e.surname
          td = e.username
          td.d-none.d-lg-table-cell = user_class_names(e)
          td = link_to('Reset Password', reset_password_user_path(id: e.id),
            class: 'btn btn-dark reset-password reset-password-student',
            data: { controller: 'password-reset', action: 'click->password-reset#reset' })
