h1.page-section-header.text-uppercase Employees
hr.small.mb-5.primary-red
div data-controller='table' data-table-page-length-value='25'
  .tj-table-toolbar
    input.tjk-input type='search' placeholder='Search employees…' data-table-target='search' data-action='input->table#search' style='flex:1; max-width:50%'
    button.tj-btn-secondary.tj-btn--sm type='button' data-action='click->table#exportCsv' Export CSV
  .tj-table-responsive
    table.tj-table#employees-table
      thead
        th Name
        th Username
        th.tj-hide-md Classes
        th Reset Password?
      tbody
        - @employees.each do |e|
          tr.employee-row data-id=e.id
            td
              => e.forename
              = e.surname
            td = e.username
            td.tj-hide-md = get_user_classes(e)
            td =link_to('Reset Password',
                  reset_password_user_path(id: e.id),
                  class: 'tj-btn-dark reset-password reset-password-student',
                  remote: true,
                  id: dom_id(e),
                  data: { turbo_method: :patch })
  .tj-table-controls
    button.tj-btn-secondary.tj-btn--sm type='button' data-table-target='prev' data-action='click->table#prev' ‹ Prev
    span data-table-target='info'
    button.tj-btn-secondary.tj-btn--sm type='button' data-table-target='next' data-action='click->table#next' Next ›
