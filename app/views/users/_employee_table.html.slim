section.tjs-dashboard__section#employees
  = render 'shared/skin/section_head', en: 'Employees', jp: '職員'
  div data-controller='table' data-table-page-length-value='25'
    .tj-table-toolbar
      input.tj-table-search type='search' placeholder='Search employees…' data-table-target='search' data-action='input->table#search'
      button.tjs-btn.tjs-btn--ghost.tj-btn--sm type='button' data-action='click->table#exportCsv' Export CSV
    .tjs-card.tj-table-card
      table.tj-table#employees-table
        thead
          th Name
          th Username
          th.tj-hide-md Classes
          th Reset Password?
        tbody
          - @employees.each do |e|
            tr.employee-row data-id=e.id
              td
                => e.forename
                = e.surname
              td = e.username
              td.tj-hide-md = get_user_classes(e)
              td = link_to('Reset Password',
                    reset_password_user_path(id: e.id),
                    class: 'tjs-btn tjs-btn--ghost tj-btn--sm reset-password reset-password-student',
                    id: dom_id(e),
                    data: { turbo_method: :patch })
    .tj-table-controls
      button.tjs-btn.tjs-btn--ghost.tj-btn--sm type='button' data-table-target='prev' data-action='click->table#prev' ‹ Prev
      span.tj-table-info data-table-target='info'
      button.tjs-btn.tjs-btn--ghost.tj-btn--sm type='button' data-table-target='next' data-action='click->table#next' Next ›
