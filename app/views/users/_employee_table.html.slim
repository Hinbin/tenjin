h1.page-section-header.text-uppercase Employees
hr.small.mb-5.primary-red
div data-controller='table' data-table-page-length-value='25'
  .d-flex.justify-content-between.mb-2
    input.form-control.w-50 type='search' placeholder='Search employees…' data-table-target='search' data-action='input->table#search'
    button.btn.btn-secondary.btn-sm type='button' data-action='click->table#exportCsv' Export CSV
  .col.table-responsive
    table.table#employees-table
      thead
        th Name
        th Username
        th.d-none.d-lg-block Classes
        th Reset Password?
      tbody
        - @employees.each do |e|
          tr.employee-row data-id=e.id
            td
              => e.forename
              = e.surname
            td = e.username
            td.d-none.d-lg-block = get_user_classes(e)
            td =link_to('Reset Password',
                  reset_password_user_path(id: e.id),
                  class: 'btn btn-dark reset-password reset-password-student',
                  remote: true,
                  id: dom_id(e),
                  data: { turbo_method: :patch })
  .d-flex.justify-content-between.align-items-center.mt-2
    button.btn.btn-sm.btn-secondary type='button' data-table-target='prev' data-action='click->table#prev' ‹ Prev
    span data-table-target='info'
    button.btn.btn-sm.btn-secondary type='button' data-table-target='next' data-action='click->table#next' Next ›
