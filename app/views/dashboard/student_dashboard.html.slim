-content_for :title
  title=('Dashboard')
section.page-section.tj-text-center#newQuiz
  .tjk-container#startAQuizContainer
    h1.page-section-header.text-uppercase Start a Quiz
    p.lead Select a subject below
    ==render_small_separator
    .tj-carousel data-controller="carousel"
      .tj-carousel__track data-carousel-target="track"
        - @subjects.each do |s|
          .tj-carousel__item
            a href=new_quiz_path(subject: s.name)
              = subject_image_tag(s.name, class: 'subject-carousel-item-image tj-carousel__img')
              .tj-carousel__caption
                h3.text-uppercase = s.name
      button.tj-carousel__prev type="button" aria-label="Previous" data-action="click->carousel#prev"
        i.fas.fa-chevron-left aria-hidden="true"
        span.tj-sr-only Previous
      button.tj-carousel__next type="button" aria-label="Next" data-action="click->carousel#next"
        i.fas.fa-chevron-right aria-hidden="true"
        span.tj-sr-only Next
      .tj-carousel__indicators data-carousel-target="indicators"
        - @subjects.each_with_index do |s, i|
          button.tj-carousel__dot type="button" data-action="click->carousel#goTo" data-carousel-index-param=i aria-label=s.name
=render('shared/homework')
section#challenges.page-section.tj-text-center
  .tjk-container
    h1.page-section-header.text-uppercase Challenges
    ==render_small_separator
    .tj-flex.tj-justify-center
      div style='flex: 0 1 83.33%; min-width: 0'
        table.tj-table#challenge-table
          thead
            tr
              th Challenge
              th Progress
              th.tj-sm-table-cell Points
              th Expires in
          tbody
            - @challenges.each do |c|
                tr.challenge-row data-challenge=c.id data-topic=(c.daily? ? 'Lucky Dip' : c.topic.id) data-subject=c.topic.subject_id
                  td = c.stringify
                  td = write_challenge_progress(c, @challenge_progresses)
                  td.tj-sm-table-cell
                    = c.points
                    i.fas.fa-star style='color: yellow'
                  td = challenge_time_left(c)
-if current_user.oauth_email.blank?
  input#oAuthEmail type='hidden'
