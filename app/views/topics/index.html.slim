- content_for :title
  title = 'Edit Questions'
.tjs-dashboard.tjs-dashboard--teacher
  = render 'shared/skin/backdrop'
  .tjs-dashboard__inner
    header.tj-tsurface-header
      h1.tjs-display.tj-tsurface-title Edit Questions
      p.tj-tsurface-lead Manage the topics and questions for each of your subjects.

    - @subjects.each do |s|
      section.tjs-dashboard__section
        = render 'shared/skin/section_head', en: s.name
        .tj-row-actions
          = link_to 'Add Topic', new_topic_path(subject: { subject_id: s.id }), class: 'tjs-btn tjs-btn--primary'
          = link_to 'Most Flagged Questions', flagged_questions_topics_path(subject_id: s.id), class: 'tjs-btn tjs-btn--secondary'
        .tjs-card.tj-table-card
          .tj-table-responsive
            table.tj-table
              thead
                tr
                  th Topic Name
                  th Question #
              tbody
                - s.topics.select(&:active).sort_by { |t| t.name.to_s.downcase }.each do |t|
                  tr
                    td = link_to t.name, topic_path(t)
                    td = @question_counts[t.id] || 0
