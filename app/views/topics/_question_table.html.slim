div data-controller='table' data-table-page-length-value='50'
  .tj-table-toolbar
    input.tj-table-search type='search' placeholder='Search questions…' data-table-target='search' data-action='input->table#search'
  .tjs-card.tj-table-card
    .tj-table-responsive
      table.tj-table#questionTable
        thead
          tr
            th #
            th Question
            th Times Asked
            th Flags
            th % Correct
            th Lesson
        tbody
          - @questions.order(:created_at).each_with_index do |q, index|
            tr id="question-#{q.id}"
              td = index + 1
              td.question-text = link_to q.question_text.blank? ? 'Click here to edit' : q.question_text, q
              td.amount = times_asked(q)
              td.flags = q.flagged_questions.size
              td.correct = percentage_correct(q)
              td.lesson = q.lesson.present? ? q.lesson.title : '-'
  .tj-table-controls
    button.tjs-btn.tjs-btn--ghost.tj-btn--sm type='button' data-table-target='prev' data-action='click->table#prev' ‹ Prev
    span.tj-table-info data-table-target='info'
    button.tjs-btn.tjs-btn--ghost.tj-btn--sm type='button' data-table-target='next' data-action='click->table#next' Next ›
