.tjk-container
  h1.page-section-header Admin Page
  =link_to 'Invite new admin', new_admin_invitation_path, class: 'tj-btn-primary tj-btn--full'
  =link_to 'Runtime Errors', app_errors_path, class: 'tj-btn-primary tj-btn--full'
  =link_to 'Reset Year Data', reset_year_admin_path(current_admin),
              data:{ confirm: 'ARE YOU REALLY REALLY SURE?!  This will delete all current data in leaderboards, homeworks and more.',
              turbo_method: "post" },
              id: 'reset-button',
              class: 'tj-btn-danger tj-btn--full',
              style: 'margin: var(--tj-space-5) 0'

  h2.h3 Current Admins
  .tj-table-responsive
    table.tj-table#admins-table
      thead
        tr
          th Email
          th Role
          th Reset Password
          th Remove
      tbody
        - @admins.each do |admin|
          tr.admin-row id="admin-#{admin.id}"
            td = admin.email
            td = admin.role.humanize
            td = button_to 'Send Reset Email',
              reset_password_admin_path(admin),
              class: 'tj-btn-primary',
              data: { turbo_confirm: "Send password reset instructions to #{admin.email}?" }
            td = button_to 'Remove',
              admin_path(admin),
              method: :delete,
              class: 'tj-btn-danger',
              disabled: @minimum_admin_count_reached,
              data: { turbo_confirm: "Remove admin account for #{admin.email}?" }
