-dashboard_styles = customisations.dashboard_style.with_attached_image
- if dashboard_styles.any?
  section.page-section.text-center.dashboard-styles
    .tjk-container
      h3.text-uppercase Dashboard Styles
      ==render_small_separator
      -dashboard_styles.each do |style|
        .tj-card.dashboard-style style=render_dashboard_style(style)
          .tj-card-body
            h2.page-section-header.text-uppercase.text-white =style.name
            ==render_small_separator(style)
          div style='margin: var(--tj-space-5) 0'
          div style='margin: var(--tj-space-3) 0'
            -if current_admin.present?
              -if style.sticky?
                h2.text-uppercase.text-white Stickied
              -unless style.purchasable?
                h2.text-uppercase.text-white Unavailable
              =link_to 'Edit', edit_customisation_path(style), class: 'btn-light-outline'
            -else
              .tj-customisation-buy#cost
                span.text-white == customisation_cost(style, bought_customisations)
                =form_with url: buy_customisation_path(style) do |f|
                  -if bought_customisations.include? style.id
                    =f.submit 'Switch', class: 'btn-light-outline buy-btn'
                  -else
                    =f.submit 'Buy', class: 'btn-light-outline buy-btn'

-leaderboard_icon_styles = customisations.leaderboard_icon
- if leaderboard_icon_styles.any?
  section.page-section.text-center.icons
    .tjk-container
      h3.text-uppercase Leaderboard Icons
      ==render_small_separator
      .tj-icon-grid
        -leaderboard_icon_styles.each do |icon|
          .tj-card
            .tj-card-body
              p =icon.name
              i class='fas fa-2x fa-#{icon.value.split(',')[1]}' style="color: #{icon.value.split(',')[0]}"
              -if current_admin.present?
                -if icon.sticky?
                  p Stickied
                -unless icon.purchasable?
                  p Unavailable
                =link_to 'Edit', edit_customisation_path(icon), class: 'btn-dark-outline'
              -else
                p#cost
                  == customisation_cost(icon, bought_customisations)
                =form_with url: buy_customisation_path(icon) do |f|
                  -if bought_customisations.include? icon.id
                    =f.submit 'Switch', class: 'btn-dark-outline buy-btn'
                  -else
                    =f.submit 'Buy', class: 'btn-dark-outline buy-btn'
