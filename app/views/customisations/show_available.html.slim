- content_for :title
  title Reward Shop

.tjs-shop
  / Backdrop FX (skin-specific; includes equipped Scene + Ambient Motion layers)
  = render 'shared/skin/backdrop'

  .tjs-shop__inner
    / ── Wallet header ────────────────────────────────────────────────────
    header.tjs-shop__wallet
      .tjs-shop__wallet-text
        .tjs-display.tjs-shop__title Reward Shop
        p.tjs-shop__sub Cosmetic only — points change how you look, never how you score.
      .tjs-shop__balance
        = render 'shared/skin/stat', icon: :star, value: @wallet, label: 'to spend', color: 'var(--gold)'

    / ── Appearance (light/dark) switch ───────────────────────────────────
    = render 'mode_toggle'

    / ── Category sections (one equip slot each) ──────────────────────────
    - @shop_categories.each do |cat|
      section.tjs-shop__cat data-cat=cat.type
        = render 'shared/skin/section_head', en: cat.en, jp: cat.jp
        p.tjs-shop__blurb = cat.blurb
        - if cat.type == 'skin'
          / Skins get full-width "selling" cards, each with its own palettes grouped underneath.
          .tjs-shop__skins
            - cat.items.each do |item|
              = render 'skin_card', item: item
        - else
          .tjs-shop__grid class="tjs-shop__grid--#{cat.type}"
            - cat.items.each do |item|
              = render 'shop_item', item: item, type: cat.type
