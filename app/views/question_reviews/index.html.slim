.tjk-container data-controller='review-queue'
  h1.tj-review__title Review Queue

  p.tj-empty data-review-queue-target='empty' hidden=@questions_by_topic.any?
    | No questions are waiting for review.
  - unless @questions_by_topic.empty?
    .tj-row-actions
      = button_to 'Approve all', approve_all_question_reviews_path, method: :patch, class: 'tjs-btn tjs-btn--primary', data: { turbo_confirm: 'Approve every question waiting for review?' }
      = button_to 'Reject all', reject_all_question_reviews_path, method: :patch, class: 'tjs-btn tjs-btn--danger', data: { turbo_confirm: 'Reject every question waiting for review? This cannot be undone.' }
    - @questions_by_topic.each do |topic, questions|
      section.tjs-card.tj-review-topic data-review-queue-target='section'
        h2.tj-review-topic__head = "#{topic.subject.name} · #{topic.name}"
        - questions.each do |question|
          .tj-review-item id="question-#{question.id}"
            .tj-review-item__type = question.question_type.humanize
            = render 'question_reviews/preview', question: question
            .tj-review-item__actions
              = button_to 'Approve', approve_question_review_path(question), method: :patch, class: 'tjs-btn tjs-btn--primary tj-btn--sm'
              = link_to 'Edit', question_path(question), class: 'tjs-btn tjs-btn--secondary tj-btn--sm'
              = button_to 'Reject', reject_question_review_path(question), method: :patch, class: 'tjs-btn tjs-btn--ghost tj-btn--sm'
