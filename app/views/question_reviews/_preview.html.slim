/ Read-only render of an imported question, mirroring how it is presented to students (the same
/ .tjs-question atoms) but static and with the correct answer(s) revealed, so a reviewer can judge it
/ before approving. Shuffling is intentionally dropped here — authors review in the authored order.
.tj-review-preview
  .tjs-question
    - case question.question_type
    - when 'multiple'
      .tjs-question__text ==(question.question_text.presence || '(no question text)')
      .tjs-answers
        - question.answers.each_with_index do |answer, i|
          .tjs-card.tjs-tile.tjs-answer class=(answer.correct ? 'correct-answer' : nil)
            span.tjs-answer__badge = ('A'.ord + i).chr
            span.tjs-answer__text = answer.text

    - when 'short_answer'
      .tjs-question__text ==(question.question_text.presence || '(no question text)')
      / Every stored answer is an accepted spelling — show them all as the correct response.
      .tjs-answers
        - question.answers.each do |answer|
          .tjs-card.tjs-tile.tjs-answer.correct-answer
            span.tjs-answer__text = answer.text

    - when 'fill_blank'
      .tjs-cloze
        - cloze_segments(question.cloze_text).each do |kind, value|
          - if kind == :text
            span.tjs-cloze__text = value
          - else
            span.tjs-blank.correct-answer = Array(question.config.dig('answer', value)).join(' / ')

    - when 'drag_drop'
      - items = question.config.fetch('items', []).index_by { |item| item['id'] }
      - used_ids = question.config.fetch('answer', {}).values.flatten.uniq
      .tjs-cloze
        - cloze_segments(question.cloze_text).each do |kind, value|
          - if kind == :text
            span.tjs-cloze__text = value
          - else
            span.tjs-slot.correct-answer = Array(question.config.dig('answer', value)).map { |id| items.dig(id, 'text') }.join(', ')
      - distractors = question.config.fetch('items', []).reject { |item| used_ids.include?(item['id']) }
      - if distractors.any?
        .tj-review-distractors
          span.tj-review-distractors__label Distractors
          - distractors.each do |item|
            span.tjs-tile.tj-review-distractors__item = item['text']

    - when 'ordering'
      .tjs-question__text ==(question.question_text.presence || '(no question text)')
      - items = question.config.fetch('items', []).index_by { |item| item['id'] }
      - order = question.config.fetch('order', []).presence || items.keys
      ol.tjs-order-list
        - order.each do |item_id|
          li.tjs-order-item.correct-answer
            span.tjs-order-item__text = items.dig(item_id, 'text')

    - when 'matrix'
      .tjs-question__text ==(question.question_text.presence || '(no question text)')
      - columns = question.config.fetch('columns', [])
      .tj-table-responsive
        table.tjs-matrix
          thead
            tr
              th
              - columns.each do |col|
                th = col['label']
          tbody
            - question.config.fetch('rows', []).each do |row|
              - correct_ids = Array(question.config.dig('correct', row['id']))
              tr
                th scope='row' = row['label']
                - columns.each do |col|
                  td.tjs-matrix__cell class=(correct_ids.include?(col['id']) ? 'correct-answer' : nil)
                    - if correct_ids.include?(col['id'])
                      span.tj-review-cell-tick ✓

    - when 'match'
      .tjs-question__text ==(question.question_text.presence || '(no question text)')
      - rights = question.config.fetch('right', []).index_by { |right| right['id'] }
      - correct = question.config.fetch('correct', {})
      .tj-review-match
        - question.config.fetch('left', []).each do |left|
          .tj-review-match__pair
            .tjs-tile.correct-answer = left['text']
            span.tj-review-match__arrow aria-hidden='true' →
            .tjs-tile.correct-answer = rights.dig(correct[left['id']], 'text')
      - matched_ids = correct.values
      - distractors = question.config.fetch('right', []).reject { |right| matched_ids.include?(right['id']) }
      - if distractors.any?
        .tj-review-distractors
          span.tj-review-distractors__label Distractors
          - distractors.each do |right|
            span.tjs-tile.tj-review-distractors__item = right['text']

    - when 'classify'
      .tjs-question__text ==(question.question_text.presence || '(no question text)')
      - items = question.config.fetch('items', []).index_by { |item| item['id'] }
      - correct = question.config.fetch('correct', {})
      - by_target = correct.group_by { |_item_id, target_id| target_id }
      .tjs-classify__buckets
        - question.config.fetch('targets', []).each do |target|
          .tjs-bucket
            .tjs-bucket__label = target['label']
            .tjs-bucket__body
              - Array(by_target[target['id']]).each do |item_id, _target_id|
                .tjs-tile.correct-answer = items.dig(item_id, 'text')
      - distractors = question.config.fetch('items', []).reject { |item| correct.key?(item['id']) }
      - if distractors.any?
        .tj-review-distractors
          span.tj-review-distractors__label Distractors
          - distractors.each do |item|
            span.tjs-tile.tj-review-distractors__item = item['text']
