- content_for :title
  title = 'Classrooms'
.tjk-container data-controller='classroom'
  section.tj-section#classrooms
    p
      | Current school sync status:#{' '}
      b#syncStatus = @school.sync_status.humanize
    == sync_status_button
    h1.tj-section-header Classrooms
    hr.tj-hr-primary
    table.tj-table#classroom-table
      thead
        tr
          th Name
          th.tj-hide-sm Number of Students
          th Subject
      tbody
        - @classrooms.each do |c|
          tr
            td = c.name
            td.tj-hide-sm = c.enrollments.size
            td = select_tag :subject, options_from_collection_for_select(@subjects, :id, :name, c.subject_id), include_blank: '', id: 'classroom-' + c.id.to_s, class: 'tjk-input', data: { remote: 'true', url: classroom_path(c.id), turbo_method: 'patch', action: 'change->classroom#subjectChanged' }
