- content_for :title
  title = 'Classroom - ' + @classroom.name
.tjs-dashboard.tjs-dashboard--teacher data-controller='classroom'
  = render 'shared/skin/backdrop'
  .tjs-dashboard__inner
    header.tj-tsurface-header
      h1.tjs-display.tj-tsurface-title = @classroom.name
      .tj-classroom-meta
        - if @classroom.subject.present?
          span.tj-meta-chip
            | Subject:&nbsp;
            strong = @classroom.subject.name
        span.tj-meta-chip
          strong = @students.size
          |  students
        span.tj-meta-chip
          strong = @homeworks.length
          |  homeworks

    - flagged_students = @students.select { |s| @fast_flag_counts[s.id].to_i.positive? }
    - if flagged_students.any?
      .tj-alert-warning role='alert'
        i.fas.fa-exclamation-triangle aria-hidden='true'
        |
        strong Possible auto-answering detected.
        |
        = "#{flagged_students.size} #{'student'.pluralize(flagged_students.size)} #{flagged_students.size == 1 ? 'has' : 'have'} answers flagged as answered too fast to be genuine: "
        = flagged_students.map { |s| "#{s.forename} #{s.surname}" }.to_sentence

    - if policy(@classroom).gaps?
      .tj-feature-card
        .tj-feature-card__icon
          i.fas.fa-chart-line aria-hidden='true'
        .tj-feature-card__body
          .tj-feature-card__title Gap Analysis
          p.tj-feature-card__text Difficulty-aware topic heatmap, hardest questions, and per-student standing against every Tenjin student.
        .tj-feature-card__cta
          = link_to 'View Gap Analysis', gaps_classroom_path(@classroom), class: 'tjs-btn tjs-btn--primary'

    section.tjs-dashboard__section#homework
      .tj-action-card
        .tj-feature-card__icon
          i.fas.fa-clipboard-list aria-hidden='true'
        .tj-feature-card__body
          .tj-feature-card__title Homework
          p.tj-feature-card__text Set and track homework for this classroom, with completion and due dates per topic.
        .tj-feature-card__cta
          = link_to 'Set Homework', new_homework_path(classroom: { classroom_id: @classroom.id }), class: 'tjs-btn tjs-btn--primary'
      div data-controller='table' data-table-page-length-value='5' data-table-order-value='[[2,"desc"]]'
        .tjs-card.tj-table-card
          table.tj-table#homework-table
            thead
              tr
                th Topic
                th Completion
                th Due
            tbody
              - @homeworks.each do |h|
                tr.homework-data data-action='click->classroom#navigateRow' data-url=homework_path(h) data-id=h.id
                  - if h.lesson.present?
                    td = h.lesson.title
                  - else
                    td = h.topic.name
                  td = report_progress(h)
                  td data-order=h.due_date.to_i title=h.due_date.strftime('%d/%m/%y %H:%M') = humanized_due_date(h.due_date)
        .tj-table-controls
          button.tjs-btn.tjs-btn--ghost.tj-btn--sm type='button' data-table-target='prev' data-action='click->table#prev' ‹ Prev
          span.tj-table-info data-table-target='info'
          button.tjs-btn.tjs-btn--ghost.tj-btn--sm type='button' data-table-target='next' data-action='click->table#next' Next ›

    section.tjs-dashboard__section#students
      = render 'shared/skin/section_head', en: 'Students', jp: '生徒'
      div data-controller='table' data-table-page-length-value='0'
        .tj-table-toolbar
          input.tj-table-search type='search' placeholder='Search students…' data-table-target='search' data-action='input->table#search'
          .tj-check-inline
            input#resetPasswordCheck type='checkbox' data-action='change->classroom#togglePasswordCol'
            label for='resetPasswordCheck'  Reset Passwords?
          button.tjs-btn.tjs-btn--ghost.tj-btn--sm type='button' data-action='click->table#exportCsv' Export CSV
        .tjs-card.tj-table-card
          table.tj-table#students-table style='width:100%'
            thead
              tr
                th First Name
                th Last Name
                th Username
                th.password-col.tj-hidden data-no-export='true' Reset Password
                th Homeworks
            tbody
              - @students.each do |s|
                tr.student-data data-id=s.id
                  td = fast_flag_indicator(s.forename, @fast_flag_counts[s.id])
                  td = s.surname
                  td = s.username
                  td.password-col.tj-hidden = link_to 'Reset Password', reset_password_user_path(id: s.id), id: dom_id(s), class: 'tjs-btn tjs-btn--ghost reset-password reset-password-student', data: { turbo_method: :patch }
                  td = link_to(s) do
                    == student_homeworks(s, @homework_progress)
