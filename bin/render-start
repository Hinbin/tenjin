#!/usr/bin/env bash
# Boot sequence for the Render free-tier web service.
#
# The free tier has no pre-deploy hook, so we prepare the database on boot and
# then hand off to Puma. This lives in a script (rather than an inline
# `dockerCommand` with `&&`) because Render does not reliably run shell
# operators in dockerCommand — the chained string gets exec'd as one program.
#
# `db:prepare` loads the schema on a fresh database and is a no-op once
# migrated, so it is safe to run on every boot.
set -e

bundle exec rails db:prepare
exec bundle exec puma -C config/puma.rb
